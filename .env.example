# Copy to .env.local (git-ignored) for local development, or set these in your host's build settings.

# Backend base URL (no trailing slash), e.g. https://api.auriva.in. Leave empty to run on the
# in-browser mock (src/lib/api/mock.ts). See docs/backend-handoff.md.
VITE_API_URL=

# OAuth "Web application" client ID from Google Cloud Console. It's public, not a secret.
# Leave empty to hide the "Continue with Google" button. See docs/google-sign-in.md.
VITE_GOOGLE_CLIENT_ID=

# Razorpay *test* key id (rzp_test_…), only used while VITE_API_URL is empty: it lets the mock open
# Razorpay's payment window in test mode. The real backend sends its own key with each order.
# Never put the key secret here. See docs/payments.md.
VITE_RAZORPAY_KEY_ID=
